# Env template for the storefront on the staging server.
# See docs/server-deploy.md.
#
# Copy it on the server, then fill in the values:
#   cp .env.server.example .env.server
#   chmod 600 .env.server
#
# The same file is used at build time (as a BuildKit secret) and at run time
# (through `env_file` in docker-compose.yml).
#
# Never put real values in this file. It is committed to Git.
#
# HOW TO READ THIS FILE
#
#   KEY=        Required. Fill it in.
#   # KEY=      Optional. Leave it commented out, and the code uses its own
#               default (shown after "default:" when there is one).
#
#   Never leave an optional value empty (`KEY=`). An empty value is still
#   "set". Some code reads it with `??`, and then Number("") gives 0. For
#   example, an empty OTP_IP_MAX sets the OTP limit to 0
#   (serverRequests/radis/index.ts line 226).
#
#   [build] marks a value that is fixed when the image is built. A change to it
#   needs `docker compose up -d --build`. A restart is not enough.
#
# DO NOT ADD THESE
#
#   VERCEL, VERCEL_*, NX_*, TURBO_*  Vercel build values. VERCEL=1 turns on the
#                                    Sentry build wrapper in next.config.ts.
#   NODE_ENV                         The Dockerfile sets it to `production`.
#   SENTRY_AUTH_TOKEN, SENTRY_ORG,   Used only for the source map upload, which
#   SENTRY_PROJECT                   runs only on Vercel builds.
#   TEST_ACCOUNT_*, QA_SELLER_*,     Used only by the test suites, never by the
#   ADMIN_*, FLEET_*                 app.
#   WALLET_SECRET_KEY, GL_API_KEY,   In some old env files, but no app code
#   CEREBRAS_*, FIREBASE_SERVER_KEY, reads them.
#   NEXT_PUBLIC_MEDIA_API_KEY,
#   NEXT_PUBLIC_POSTHOG_HOST,
#   NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION,
#   NEXT_PUBLIC_REDEEMED_IDS_LENGHT,
#   PREFERRED_REGION

# ---------- Site ----------
# [build] The public address of this copy, with https and no trailing slash.
# Page metadata uses it. Without it, links point to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# [build] Keep false. Search engines must not index a staging copy.
NEXT_PUBLIC_ALLOW_INDEXING=false
# "on" shows only the logo page. Anything else turns the gate off.
# STAGING_GATE=
# [build]
# NEXT_PUBLIC_DEFAULT_COUNTRY=
# NEXT_PUBLIC_DEFAULT_LANGUAGE=
# NEXT_PUBLIC_APP_VERSION=
# [build] next.config.ts reads it during the build. default: 60
# HOMEPAGE_CACHE_SECONDS=

# ---------- Backends ----------
# Core backend.
BACKEND_URL=
# Gateway. The code still reads this old name (a rename is pending).
GO_BACKEND_URL=
STORIES_BACKEND_URL=
COMMENT_BACKEND_URL=
WALLET_BACKEND_URL=
WALLET_PUBLIC_API_KEY=
ELASTIC_BACKEND_URL=
# [build]
NEXT_PUBLIC_CHAT_BACKEND_URL=
# [build] default: the staging Agora app id (utils/agoraConfig.ts)
# NEXT_PUBLIC_AGORA_APP_ID=

# ---------- Media ----------
# [build]
NEXT_PUBLIC_MEDIA_SERVER_BASE_URL=
NEXT_PUBLIC_BASE_MEDIA_URL=
NEXT_PUBLIC_BASE_VIDEO_MEDIA_URL=

# ---------- Elasticsearch ----------
ELASTICSEARCH_NODE=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# ELASTIC_LISTING_PIT=
# ELASTIC_LISTING_PIT_KEEPALIVE=
# LISTING_PRICE_AGG_ENABLED=
# LISTING_PRICE_AGG_DEBUG=
# MIN_CATEGORIES_UNDER_BOUTIQUE=
# Index names. default: the staging index names in services/elastic/INDEXES.ts
# ELASTIC_CATALOG_INDEX=
# ELASTIC_VIEWS_INDEX=
# ELASTIC_RECOMMENDATION_INDEX=
# ELASTIC_RECOMMENDATION_COLD_INDEX=
# ELASTIC_COMMENTS_INDEX=
# ELASTIC_PRODUCT_INTERACTIONS_INDEX=
# ELASTIC_USER_INTERACTIONS_INDEX=
# ELASTIC_COMMENTS_INTERACTIONS_INDEX=
# ELASTIC_SHARE_INDEX=
# ELASTIC_SEARCH_LOG_INDEX=

# ---------- Redis ----------
# The rate limits use Redis. Without it, the image and voice search routes
# answer "busy" (utils/server/paidRouteGuard.ts).
REDIS_URL=
REDIS_USERNAME=
REDIS_PASS=
# PRODUCT_REDIS_TTL_SECONDS=

# ---------- Cookies and OTP ----------
# Secret.
OTP_KEY_SALT=
# TOKEN_COOKIE_MAX_AGE=
# DEFAULT_COOKIE_MAX_AGE=
# default: 60
# OTP_COOLDOWN_SECONDS=
# default: 3600
# OTP_WINDOW_SECONDS=
# default: 4
# OTP_IP_MAX=
# default: 2
# OTP_SESSION_MAX=
# OTP_TEST_PHONES=

# ---------- Seller comments limits ----------
# default: 30
# SELLER_COMMENTS_PERMS_TTL=
# default: 3600
# SELLER_COMMENTS_PERMS_STALE_TTL=
# default: 60
# SELLER_COMMENTS_READ_LIMIT=
# default: 60
# SELLER_COMMENTS_READ_WINDOW=
# default: 20
# SELLER_COMMENTS_WRITE_LIMIT=
# default: 60
# SELLER_COMMENTS_WRITE_WINDOW=

# ---------- Firebase (push notifications) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One line, in double quotes, with \n for each line break.
FIREBASE_PRIVATE_KEY=

# ---------- AI search and voice search ----------
GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=
# default: GEMINI_API_KEY
# GEMINI_EMBEDDING_API_KEY=
# GEMINI_SEARCH_MODEL=
# GEMINI_IMAGE_SEARCH_MODEL=
# IMAGE_SEARCH_MIN_SIMILARITY=
# IMAGE_SEARCH_TIMEOUT_MS=
# SEARCH_ANALYZE_CACHE_SECONDS=
# SEARCH_ANALYZE_MAX_PER_MINUTE=
# SEARCH_ANALYZE_TIMEOUT_MS=
# ASSEMBLYAI_BASE_URL=

# ---------- Sentry ----------
# [build]
NEXT_PUBLIC_DSN_SENTRY=
# Name this copy, so its errors stay apart from the Vercel copy. Without it,
# Sentry reports them as "production" (the NODE_ENV fallback).
SENTRY_ENVIRONMENT=staging-server
# [build] The browser copy of the same name.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging-server

# ---------- Analytics ----------
# [build]
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_ANALYTICS_LOG=

# ---------- Page features and links ----------
# [build]
# Without it, the map in the address form does not load. The form still
# saves (utils/mapsConfig.ts).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_PLAY_STORE_URL=
# NEXT_PUBLIC_QR_LOGIN_ENABLED=
# NEXT_PUBLIC_IS_STORE_LAST_JSON=
# default: 5
# NEXT_PUBLIC_MAX_ARRAY_LENGTH=
# default: https://www.facebook.com/trydos
# NEXT_PUBLIC_FACEBOOK_URL=
# default: https://www.instagram.com/trydos
# NEXT_PUBLIC_INSTAGRAM_URL=

# ---------- QA ----------
# Secret. Empty or commented out turns QA mode off.
# QA_VIEW_SECRET=
# [build]
# NEXT_PUBLIC_QA_STORY_VIEWER_PHONES=
# NEXT_PUBLIC_QA_STORY_LINK_HOST=

# ---------- Request logging & observability ----------
# Environment label attached to structured JSON logs. default: SENTRY_ENVIRONMENT or NODE_ENV
# APP_ENV=staging
# Minimum HTTP access log level: trace | debug | info | warn | error. default: info
# LOG_LEVEL=info
# "json" emits single-line structured JSON for Docker json-file / Loki shippers.
# Leave unset on Vercel to keep plain-text searchable lines.
# LOG_FORMAT=json
# "1" turns on backend call logging (reqLogger). The log goes to `docker compose logs`.
# REQ_LOG=1
# REQ_LOG_BODY=
