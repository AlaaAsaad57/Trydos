{
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "@/*": ["./*"],
      "assets/*": ["./public/*"],
      "styles/*": ["./public/styles/*"],
      "services/*": ["./services/*"],
      "components/*": ["./components/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "types": ["node","vitest/globals"],
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx", // React 19 uses automatic JSX runtime
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "ES2017", // Consider updating to ES2020+ for better React 19 support
    "strictNullChecks": false
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    // The seven .jsx files in the app (store/homepage/actions.jsx and the six
    // call screens under app/(special)) were outside this list. Path aliases
    // are applied per tsconfig `include`, so nothing here resolved
    // "services/story" or "utils/GAEvents" inside them — which the app's own
    // bundler papers over and the test runner does not.
    "**/*.jsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
