# Trydos — every environment variable the code reads.
#
# **This file holds NO values, and must never hold one.** The repository is
# public: a value committed here is a value published. Real values live in the
# untracked `.env.development` (local) and in the deployment's own settings
# (Vercel) or the repository's secrets (CI).
#
# Copy it to start a new environment:
#
#     cp .env.example .env.development
#
# The list is generated from the code — every `process.env.X` under `app/`,
# `components/`, `services/`, `serverRequests/`, `utils/`, `store/`,
# `proxy.ts`, `next.config.ts`, the instrumentation files, and the browser
# suite's harness. Platform-injected names (`VERCEL_*`, `TURBO_*`, `CI`,
# `NODE_ENV`, `NEXT_RUNTIME`) are left out: nothing sets them by hand.
#
# Each line is marked:
#
#   [required]  the app or the suite cannot work without it
#   [optional]  there is a fallback in code, named where it is not obvious
#   [e2e]       read only by the browser suite, never by the app
#
# **`NEXT_PUBLIC_` is not a secret marker — it is the opposite.** Anything with
# that prefix is inlined into the JavaScript bundle at build time and is
# readable by every visitor. Never put a credential behind it.


# ---------------------------------------------------------------------------
# The two storefront backends
# ---------------------------------------------------------------------------
# Referred to by role, never by the technology behind them: the **core**
# backend serves verified users, the **gateway** serves guest and allow-listed
# traffic. `GO_BACKEND_URL` is the gateway under its old name; the rename is
# pending across the app, so both halves must move together.

BACKEND_URL=                          # [required] the core backend
GO_BACKEND_URL=                       # [required] the gateway (rename pending)


# ---------------------------------------------------------------------------
# The other services
# ---------------------------------------------------------------------------

STORIES_BACKEND_URL=                  # [required] stories: feed, upload, report, delete
NEXT_PUBLIC_CHAT_BACKEND_URL=         # [required] chat
COMMENT_BACKEND_URL=                  # [required] product comments
WALLET_BACKEND_URL=                   # [required] wallet
WALLET_PUBLIC_API_KEY=                # [required] wallet
WALLET_SECRET_KEY=                    # [required] wallet — server only, never expose
ELASTIC_BACKEND_URL=                  # [required] the recommendation engine


# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# Two addresses on purpose: the first is where the browser uploads, the second
# where it reads a picture back. Both must be https — one of them carries an
# API key in a header.

NEXT_PUBLIC_MEDIA_SERVER_BASE_URL=    # [required] uploads
NEXT_PUBLIC_MEDIA_API_KEY=            # [required] uploads
NEXT_PUBLIC_BASE_MEDIA_URL=           # [required] reading images back
NEXT_PUBLIC_BASE_VIDEO_MEDIA_URL=     # [required] reading video back


# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------

ELASTICSEARCH_NODE=                   # [required] the search index
ELASTICSEARCH_USERNAME=               # [required]
ELASTICSEARCH_PASSWORD=               # [required]
ELASTIC_LISTING_PIT=                  # [optional] point-in-time reads for listing paging
ELASTIC_LISTING_PIT_KEEPALIVE=        # [optional] how long a point-in-time is held
LISTING_PRICE_AGG_ENABLED=            # [optional] price aggregation on listings
LISTING_PRICE_AGG_DEBUG=              # [optional] logs the aggregation's own numbers
MIN_CATEGORIES_UNDER_BOUTIQUE=        # [optional] how many categories a boutique must fill


# ---------------------------------------------------------------------------
# Cache and storage
# ---------------------------------------------------------------------------

REDIS_URL=                            # [required] rate limits and product cache
REDIS_USERNAME=                       # [optional] when the server wants one
REDIS_PASS=                           # [optional] when the server wants one
PRODUCT_REDIS_TTL_SECONDS=            # [optional] how long a product stays cached
HOMEPAGE_CACHE_SECONDS=               # [optional] falls back to 60


# ---------------------------------------------------------------------------
# Sign-in, cookies, and one-time codes
# ---------------------------------------------------------------------------
# The limiter is deliberately tight for the public and wrong for people who
# have to sign in over and over. `OTP_TEST_PHONES` is the exemption — a short
# list of numbers the team owns. It does not skip the send and it is not a
# login bypass; see `utils/server/otpAllowlist.ts`.

TOKEN_COOKIE_MAX_AGE=                 # [optional] auth cookie lifetime
DEFAULT_COOKIE_MAX_AGE=               # [optional] ordinary cookie lifetime
OTP_KEY_SALT=                         # [required] salts the rate-limit keys
OTP_COOLDOWN_SECONDS=                 # [optional] per-IP wait between sends
OTP_WINDOW_SECONDS=                   # [optional] the window the caps count over
OTP_IP_MAX=                           # [optional] sends per IP per window
OTP_SESSION_MAX=                      # [optional] distinct numbers per session
OTP_TEST_PHONES=                      # [optional] numbers exempt from OUR limiter, comma-separated


# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------

FIREBASE_PROJECT_ID=                  # [required] for push
FIREBASE_CLIENT_EMAIL=                # [required] for push
FIREBASE_PRIVATE_KEY=                 # [required] one line, with \n escapes, double-quoted
FIREBASE_SERVER_KEY=                  # [optional] legacy send path
FCM_DASHBOARD_TOKEN=                  # [optional] the dashboard's own sender


# ---------------------------------------------------------------------------
# Error reporting and analytics
# ---------------------------------------------------------------------------

ENABLE_SENTRY=                        # [optional] "true" turns Sentry on; off otherwise
NEXT_PUBLIC_DSN_SENTRY=               # [optional] required only when Sentry is on
SENTRY_ORG=                           # [optional] source map upload at build time
SENTRY_PROJECT=                       # [optional] source map upload at build time
NEXT_PUBLIC_GA_MEASUREMENT_ID=        # [optional] Google Analytics
NEXT_PUBLIC_POSTHOG_KEY=              # [optional] PostHog — session replay and events
NEXT_PUBLIC_ANALYTICS_LOG=            # [optional] prints analytics events to the console


# ---------------------------------------------------------------------------
# AI services
# ---------------------------------------------------------------------------

CEREBRAS_API_KEY=                     # [optional] search-text analysis
CEREBRAS_MODEL=                       # [optional] which model to ask
GEMINI_API_KEY=                       # [optional] the earlier analyser
ASSEMBLYAI_API_KEY=                   # [optional] voice
ASSEMBLYAI_BASE_URL=                  # [optional] voice


# ---------------------------------------------------------------------------
# The storefront itself
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=                 # [required for SEO] the public address
NEXT_PUBLIC_ALLOW_INDEXING=           # [required for SEO] keep OFF until launch
NEXT_PUBLIC_DEFAULT_COUNTRY=          # [optional] falls back to gb
NEXT_PUBLIC_DEFAULT_LANGUAGE=         # [optional] falls back to en
NEXT_PUBLIC_APP_VERSION=              # [optional] shown in support screens
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=      # [optional] address picking
NEXT_PUBLIC_FACEBOOK_URL=             # [optional] has a built-in default
NEXT_PUBLIC_INSTAGRAM_URL=            # [optional] has a built-in default
NEXT_PUBLIC_MAX_ARRAY_LENGTH=         # [optional] caps a list the client builds
NEXT_PUBLIC_IS_STORE_LAST_JSON=       # [optional] developer aid
STAGING_GATE=                         # [optional] "on" puts the logo page in front of the storefront


# ===========================================================================
# THE QA SAFETY LOCK
# ===========================================================================
# Test data is marked in the data itself and filtered out of every way a
# customer could discover it. These two settings are the only way to see it
# again — and **neither may ever be set on a deployed app**.
#
# The rule is not paperwork. `QA_VIEW_SECRET` is checked on the server, so a
# browser cannot fake it; the story list is `NEXT_PUBLIC_`, so on a build that
# has it set the numbers are in the bundle. Both belong only to the app the
# e2e harness builds, starts on a loopback port, and throws away.

QA_VIEW_SECRET=                       # [e2e] 32+ characters, or it is ignored. NEVER on a deployed app
NEXT_PUBLIC_QA_STORY_VIEWER_PHONES=   # [e2e] usually leave EMPTY — harness/server.ts fills it from the test phones
NEXT_PUBLIC_QA_STORY_LINK_HOST=       # [optional] overrides the QA story mark host; has a code default


# ===========================================================================
# THE BROWSER SUITE ONLY — never read by the app
# ===========================================================================
# Missing any of these is a clean **skip**, never a failure, and the skip names
# what is absent. A fresh checkout with none of them still gets a green run.

TEST_ACCOUNT_PHONE=                   # [e2e] Shopper A — uploads, buys, deletes
TEST_ACCOUNT_OTP=                     # [e2e] Shopper A's allow-listed code
TEST_ACCOUNT_PHONE_2=                 # [e2e] Shopper B — the QA seller, and the account that reports
TEST_ACCOUNT_OTP_2=                   # [e2e] Shopper B's OWN code. The shared one is refused for B

QA_SELLER_PHONE=                      # [e2e] the seed's vendor-request number; has a default
QA_SELLER_PASSWORD=                   # [e2e] the seed's seller password; generated when unset

ADMIN_DASHBOARD_BASE_URL=             # [e2e] the two approvals the seed cannot do any other way
ADMIN_DASHBOARD_EMAIL=                # [e2e]
ADMIN_DASHBOARD_PASSWORD=             # [e2e]
ADMIN_VENDOR_REQUESTS_PATH=           # [e2e] overrides the admin path; has a default
ADMIN_SELLER_BOUTIQUES_PATH=          # [e2e] overrides the admin path; has a default
ADMIN_ORDERS_LIST_PATH=               # [e2e] the order list CMT-09 searches; has a default

# CMT-09 drives the admin's order screens. They belong to another product and
# can change without this repository hearing about it, so every locator it uses
# can be replaced here. All of them have a working default.
ADMIN_SELECTOR_ORDER_DETAILS_LINK=    # [e2e] the link from a list row to one order
ADMIN_SELECTOR_ORDER_STATUS=          # [e2e] the status control on the order page
ADMIN_SELECTOR_WEIGHT_MODAL=          # [e2e] the weight form shown before "ready to shipping"
ADMIN_SELECTOR_WEIGHT_SAVE=           # [e2e] that form's save control
ADMIN_SELECTOR_CONFIRM=               # [e2e] the dashboard's "are you sure" button

FLEET_BASE_URL=                       # [e2e] the delivery worker — a separate product
FLEET_EMAIL=                          # [e2e]
FLEET_PASSWORD=                       # [e2e]
FLEET_LOGIN_PATH=                     # [e2e] the fleet sign-in screen; has a default
FLEET_SELECTOR_EMAIL=                 # [e2e] fleet sign-in locators; all have defaults
FLEET_SELECTOR_PASSWORD=              # [e2e]
FLEET_SELECTOR_SUBMIT=                # [e2e]
FLEET_SELECTOR_CHANGE_STATUS=         # [e2e] the "Change Status" button on a delivery row
