{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trydos",
  "main": ".open-next/worker.js",

  // nodejs_compat gives the Worker the Node APIs this app relies on (crypto,
  // http/https, streams, buffer). The date is not cosmetic:
  //   >= 2024-09-23  required by @opennextjs/cloudflare at all
  //   >= 2025-05-05  or FinalizationRegistry is undefined at runtime
  //   >= 2025-08-16  adds https.request, which the Sentry SDK needs
  // 2025-08-16 is the earliest date that satisfies all three. Do not lower it.
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // The account is supplied by CLOUDFLARE_ACCOUNT_ID in the environment, never
  // written here — this file is committed. Secrets (the API token, and any
  // runtime secret such as REDIS_REST_TOKEN) go in .dev.vars locally and in
  // `wrangler secret put` for production. Both are gitignored.

  // --- Cache storage. See open-next.config.ts for why each one is needed. ---
  // These binding NAMES are fixed by OpenNext. The bucket / database names are
  // ours. Create them once:
  //   wrangler r2 bucket create trydos-next-inc-cache
  //   wrangler d1 create trydos-next-tag-cache   <- prints the database_id
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "trydos-next-inc-cache",
    },
  ],

  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "trydos-next-tag-cache",
      // TODO: paste the id printed by `wrangler d1 create`. Deploy fails
      // loudly if this is left empty, which is the behaviour we want — a
      // silently missing tag cache would make /api/revalidate a no-op.
      "database_id": "",
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],

  "observability": {
    "enabled": true,
  },
}
