# .i18nignore — paths the hardcoded-text scanner should skip.
#
# Gitignore syntax. These are excluded *in addition* to .gitignore and the
# scanner's built-in defaults (node_modules, .next, .git, etc.).
# Use this file for source that is real code but never customer-facing copy:
# API routes, internal dev/admin tooling, test fixtures.
#
# To suppress a single finding instead, put `// i18n-ignore` on the line above
# it, or `// i18n-ignore-file` near the top of the file.

# Server API route handlers — responses are not localized UI copy.
app/api/

# Internal dev / debug tooling pages (never shown to customers).
app/fcm-dashboard/
app/(client)/api-test/
app/(client)/requests-log/
app/(client)/backend-compare/
app/simulateUser/

# Developer test harness for push notifications ("Test" buttons + dev notes).
components/global/NotificationsTest.tsx
