{
  "firewall": {
    "rules": [
      {
        "name": "Block Meta Crawlers",
        "description": "Block Meta social media crawlers before they reach the app",
        "action": "deny",
        "conditionGroup": [
          {
            "conditions": [
              {
                "type": "user_agent",
                "op": "inc",
                "value": "facebookexternalhit"
              }
            ]
          },
          {
            "conditions": [
              {
                "type": "user_agent",
                "op": "inc",
                "value": "FacebookBot"
              }
            ]
          },
          {
            "conditions": [
              {
                "type": "user_agent",
                "op": "inc",
                "value": "meta-externalagent"
              }
            ]
          },
          {
            "conditions": [
              {
                "type": "user_agent",
                "op": "inc",
                "value": "Facebot"
              }
            ]
          }
        ]
      }
    ]
  }
}
