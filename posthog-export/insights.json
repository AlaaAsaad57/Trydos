          {
            "kind": "GroupNode",
            "name": "share_content, enable_product_notifications",
            "nodes": [
              { "kind": "EventsNode", "name": "share_content", "event": "share_content" },
              { "kind": "EventsNode", "name": "enable_product_notifications", "event": "enable_product_notifications" }
