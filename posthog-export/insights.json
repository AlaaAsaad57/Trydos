[
  {
    "_source_short_id": "PvSqbafm",
    "_dashboard": null,
    "_starter": false,
    "name": "OTP abuse — repeat senders by IP (5days)",
    "description": "Raw client IPs with more than one OTP send attempt in the last 5 days, backed by the server-side otp_send_attempt event (utils/server/otpTelemetry.ts). 'blocked' = hit the Redis limiter (strongest abuse signal). EMPTY until the otp_send_attempt event is deployed to production. Copy the top 'ip' values into the Vercel Firewall to block.",
    "favorited": true,
    "tags": [],
    "query": {
      "kind": "DataVisualizationNode",
      "source": {
        "kind": "HogQLQuery",
        "query": "SELECT properties.ip AS ip, count() AS total_attempts, countIf(properties.outcome = 'blocked') AS blocked, countIf(properties.outcome = 'sent') AS sent, countIf(properties.outcome = 'failed') AS failed, uniqExact(distinct_id) AS sessions, max(timestamp) AS last_seen FROM events WHERE event = 'otp_send_attempt' AND timestamp > now() - INTERVAL 5 DAY GROUP BY ip HAVING blocked > 1 ORDER BY blocked DESC, total_attempts DESC LIMIT 100"
      },
      "display": "ActionsTable",
      "chartSettings": {
        "xAxis": { "column": "last_seen" },
        "yAxis": [
          { "column": "total_attempts", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "blocked", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "sent", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "failed", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "sessions", "settings": { "formatting": { "prefix": "", "suffix": "" } } }
        ]
      },
      "tableSettings": {
        "columns": [
          { "column": "ip", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "total_attempts", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "blocked", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "sent", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "failed", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "sessions", "settings": { "formatting": { "prefix": "", "suffix": "" } } },
          { "column": "last_seen", "settings": { "formatting": { "prefix": "", "suffix": "" } } }
        ]
      }
    }
  },
  {
    "_source_short_id": "uud6msiQ",
    "_dashboard": null,
    "_starter": false,
    "name": "OTP abuse — repeat senders by session (7d)",
    "description": "Sessions that requested OTP more than once in the last 7 days, with geo context. Client send_otp/resend_otp carry no raw IP (PostHog discards it at ingestion), so this groups by session_id + geoip. For raw IPs to blocklist, see the 'by IP' insight backed by the server-side otp_send_attempt event.",
    "favorited": true,
    "tags": [],
    "query": {
      "kind": "DataVisualizationNode",
      "source": {
        "kind": "HogQLQuery",
        "query": "SELECT properties.session_id AS session_id, properties.$geoip_city_name AS city, properties.$geoip_country_name AS country, count() AS otp_sends, min(timestamp) AS first_send, max(timestamp) AS last_send FROM events WHERE event IN ('send_otp','resend_otp') AND timestamp > now() - INTERVAL 7 DAY GROUP BY session_id, city, country HAVING otp_sends > 1 ORDER BY otp_sends DESC LIMIT 100"
      },
      "display": "ActionsTable"
    }
  },
